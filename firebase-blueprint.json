{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and balance",
      "type": "object",
      "properties": {
        "phone": { "type": "string", "description": "User phone number (optional for Google users)" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "balance": { "type": "number", "description": "Current account balance" },
        "activeVip": { "type": "number", "description": "Current active VIP level ID" },
        "loanBalance": { "type": "number", "description": "Current pending loan amount" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "Access level" },
        "inviteCode": { "type": "string", "description": "Unique invitation code for the user" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["balance", "activeVip", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Record of deposits, withdrawals, and rewards",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Reference to the user phone" },
        "type": { "type": "string", "enum": ["deposit", "withdraw", "reward", "investment"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "method": { "type": "string", "description": "Payment method used" },
        "proofUrl": { "type": "string", "description": "Base64 or URL of the payment proof screenshot" },
        "date": { "type": "string", "description": "Display date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "status", "createdAt"]
    },
    "AiMessage": {
      "title": "AI Interaction",
      "description": "Message history for the AI helper",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Reference to the user UID" },
        "role": { "type": "string", "enum": ["user", "bot"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "text", "createdAt"]
    },
    "SupportMessage": {
      "title": "Support Chat Message",
      "description": "Real-time chat message between user and support agents",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Room ID (User UID)" },
        "senderId": { "type": "string", "description": "UID of the sender" },
        "role": { "type": "string", "enum": ["user", "agent"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "senderId", "role", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{phone}": {
      "schema": "User",
      "description": "User profiles indexed by phone number"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "All financial transactions"
    },
    "/ai_messages/{messageId}": {
      "schema": "AiMessage",
      "description": "AI helper message history"
    },
    "/support_messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Real-time support chat messages"
    }
  }
}
