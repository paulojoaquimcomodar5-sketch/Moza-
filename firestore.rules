rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    // In this implementation, we use Firebase Auth UID as the key.
    // The phone number is stored inside the document.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId 
        && incoming().balance == 25 // Initial bonus
        && incoming().activeVip == 0
        && incoming().phone is string && incoming().phone.size() >= 9
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      
      allow update: if isOwner(userId)
        && incoming().phone == existing().phone // Phone is immutable
        && incoming().createdAt == existing().createdAt // CreatedAt is immutable
        && incoming().updatedAt == request.time;
    }

    // --- Transactions ---
    match /transactions/{transactionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().amount is number
        && incoming().type in ['deposit', 'withdraw', 'reward', 'investment']
        && incoming().status in ['pending', 'completed', 'failed']
        && incoming().createdAt == request.time;
      
      // Usually users shouldn't update their own transactions except for maybe cancelling a pending one?
      // For now, let's keep it restricted.
      allow update: if false; 
    }
  }
}
