rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == '858778905@moza.com' ||
          request.auth.token.email == '258858778905@moza.com' ||
          request.auth.token.email == 'paulojoaquimcomodar5@gmail.com'
        )) ||
        request.auth.uid == 'm8ObXjhxx9e3oUgZwyQB1OIcc472'
      );
    }

    function isSystemAdmin() {
      return isAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'
      );
    }

    // --- System Settings ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }

    // --- Users ---
    // In this implementation, we use Firebase Auth UID as the key.
    // The phone number is stored inside the document.
    match /users/{userId} {
      allow get: if isOwner(userId) || isSystemAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId 
        && incoming().balance == 25 // Initial bonus
        && incoming().activeVip == 0
        && incoming().phone is string && incoming().phone.size() >= 9
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      
      allow update: if (isOwner(userId)
        && incoming().phone == existing().phone // Phone is immutable
        && incoming().createdAt == existing().createdAt // CreatedAt is immutable
        && incoming().updatedAt == request.time)
        || isSystemAdmin();
    }

    // --- Transactions ---
    match /transactions/{transactionId} {
      allow list: if (isSignedIn() && (resource.data.userId == request.auth.uid)) || isAdmin();
      allow get: if (isSignedIn() && (resource.data.userId == request.auth.uid)) || isAdmin();
      
      allow create: if (isSignedIn() 
        && (request.auth.token.email_verified == true || request.auth.uid == 'm8ObXjhxx9e3oUgZwyQB1OIcc472')
        && incoming().userId == request.auth.uid
        && incoming().amount is number
        && incoming().type in ['deposit', 'withdraw', 'reward', 'investment']
        && incoming().status in ['pending', 'completed', 'failed']
        && (incoming().get('proofUrl', '') is string)
        && incoming().createdAt == request.time)
        || isSystemAdmin();
      
      allow update: if isSystemAdmin(); 
    }

    // --- AI Messages ---
    match /ai_messages/{messageId} {
      allow list: if (isSignedIn() && (resource.data.userId == request.auth.uid)) || isAdmin();
      allow get: if (isSignedIn() && (resource.data.userId == request.auth.uid)) || isAdmin();
      
      allow create: if (isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().role in ['user', 'bot']
        && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 10000
        && incoming().createdAt == request.time);
      
      allow update, delete: if false;
    }

    // --- Support Messages ---
    match /support_messages/{messageId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if (isSignedIn() 
        && incoming().userId is string
        && (incoming().userId == request.auth.uid || isAdmin())
        && incoming().senderId == request.auth.uid
        && incoming().role in ['user', 'agent']
        && (incoming().role == 'agent' ? isAdmin() : true)
        && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 10000
        && incoming().createdAt == request.time);
      
      allow update, delete: if false;
    }
  }
}
